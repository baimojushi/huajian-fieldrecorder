<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/paper">

    <ScrollView android:id="@+id/panel_prepare" android:layout_width="match_parent"
        android:layout_height="match_parent" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:padding="22dp" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="H U A J I A N    /    FIELD NOTES 01" android:letterSpacing="0.09"
                android:textSize="11sp" android:textColor="@color/sage" android:layout_marginTop="14dp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                style="@style/Heading.Large" android:text="让绘画的过程\n被温柔记录。"
                android:lineSpacingExtra="5dp" android:layout_marginTop="22dp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="完整录像 · Qwen3 语音情绪 · 时间轴 · GPT-6 资料包"
                android:textColor="@color/subtext" android:textSize="13sp" android:layout_marginTop="12dp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@drawable/card_surface" android:layout_marginTop="28dp"
                android:padding="18dp" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="01  参与者匿名代号" android:textColor="@color/ink"
                    android:textStyle="bold" android:textSize="16sp"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="可记录多人。不做声纹注册，交由后续人工与模型核对。"
                    android:textColor="@color/subtext" android:textSize="12sp"
                    android:layout_marginTop="8dp"/>
                <EditText android:id="@+id/participants" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:minHeight="52dp"
                    android:hint="C1:儿童,A1:成人,A2:成人" android:singleLine="true"
                    android:inputType="text" android:text="C1:儿童,A1:成人"
                    android:textColor="@color/ink" android:textSize="14sp"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@drawable/card_surface" android:layout_marginTop="16dp"
                android:padding="18dp" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="02  录制前的知情与同意" android:textColor="@color/ink"
                    android:textStyle="bold" android:textSize="16sp"/>
                <CheckBox android:id="@+id/consent_guardian" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:minHeight="48dp"
                    android:text="监护人已知情并同意采集" android:textColor="@color/ink" android:textSize="13sp"/>
                <CheckBox android:id="@+id/consent_adults" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:minHeight="48dp"
                    android:text="现场成人均已知情并同意" android:textColor="@color/ink" android:textSize="13sp"/>
                <CheckBox android:id="@+id/consent_child" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:minHeight="48dp"
                    android:text="已向儿童适龄说明，儿童愿意参与" android:textColor="@color/ink" android:textSize="13sp"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@drawable/card_surface" android:layout_marginTop="16dp"
                android:padding="18dp" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="03  Qwen3 语音情绪识别设置" android:textColor="@color/ink"
                    android:textStyle="bold" android:textSize="16sp"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="5dp" android:textColor="@color/subtext" android:textSize="12sp"
                    android:text="可选。录制后人工点击才会上传音频，原始录像不会上传。API Key 经 Android Keystore 加密保存在本机。"/>
                <EditText android:id="@+id/api_key_input" android:layout_width="match_parent"
                    android:layout_height="52dp" android:hint="输入 DashScope API Key（不回显）"
                    android:inputType="textPassword" android:singleLine="true" android:textSize="14sp"/>
                <Spinner android:id="@+id/api_region" android:layout_width="match_parent"
                    android:layout_height="52dp" android:contentDescription="DashScope 地域"/>
                <EditText android:id="@+id/api_workspace" android:layout_width="match_parent"
                    android:layout_height="52dp" android:hint="Workspace ID（可留空使用旧公共域名）"
                    android:singleLine="true" android:inputType="text" android:textSize="13sp"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <Button android:id="@+id/btn_api_save" style="@style/Button.Secondary"
                        android:layout_width="0dp" android:layout_weight="1" android:layout_height="50dp"
                        android:text="安全保存 Key"/>
                    <Button android:id="@+id/btn_api_clear" style="@style/Button.Secondary"
                        android:layout_width="0dp" android:layout_weight="1" android:layout_height="50dp"
                        android:text="删除 Key"/>
                </LinearLayout>
                <TextView android:id="@+id/api_status" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:textColor="@color/subtext"
                    android:textSize="12sp" android:text="尚未保存 API Key"/>
            </LinearLayout>
            <Button android:id="@+id/btn_record" style="@style/Button.Primary"
                android:layout_width="match_parent" android:layout_height="56dp"
                android:text="●  开始现场录像" android:layout_marginTop="24dp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="8dp">
                <Button android:id="@+id/btn_system_camera" style="@style/Button.Secondary"
                    android:layout_width="0dp" android:layout_weight="1" android:layout_height="54dp"
                    android:text="系统相机"/>
                <Button android:id="@+id/btn_import" style="@style/Button.Secondary"
                    android:layout_width="0dp" android:layout_weight="1" android:layout_height="54dp"
                    android:text="导入视频"/>
            </LinearLayout>
            <Button android:id="@+id/btn_resume" style="@style/Button.Secondary"
                android:layout_width="match_parent" android:layout_height="54dp"
                android:text="继续上一次记录" android:layout_marginTop="8dp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="录像和事件默认仅保存在本机。只有人工在回看页确认云端识别后，才会把音频副本发送至阿里云；不自动上传视频或 API Key。请勿在未确认同意和云端数据处理规则时使用。"
                android:textColor="@color/subtext" android:textSize="12sp" android:lineSpacingExtra="3dp"
                android:layout_marginTop="24dp" android:layout_marginBottom="26dp"/>
        </LinearLayout>
    </ScrollView>

    <LinearLayout android:id="@+id/panel_record" android:layout_width="match_parent"
        android:layout_height="match_parent" android:orientation="vertical" android:visibility="gone"
        android:padding="14dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
            android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:text="画间 / 正在记录" android:textColor="@color/ink" android:textSize="18sp" android:textStyle="bold"/>
            <TextView android:id="@+id/record_timer" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:padding="10dp" android:text="●  00:00"
                android:textColor="@color/terracotta" android:textStyle="bold" android:textSize="17sp"/>
        </LinearLayout>
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:background="@drawable/preview_bg">
            <androidx.camera.view.PreviewView android:id="@+id/camera_preview"
                android:layout_width="match_parent" android:layout_height="match_parent"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="top|start" android:layout_margin="12dp"
                android:background="@drawable/preview_bg" android:padding="9dp"
                android:text="● REC   原声 / 连续录像" android:textColor="#FFFFFF" android:textSize="12sp"/>
        </FrameLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="11dp" android:layout_marginBottom="7dp"
            android:text="点击记录时刻  ·  长按补充现场备注"
            android:textColor="@color/subtext" android:textSize="12sp" android:gravity="center"/>
        <TableLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:stretchColumns="0,1,2">
            <TableRow android:layout_width="match_parent" android:layout_height="wrap_content">
                <Button android:id="@+id/event_0" style="@style/Button.Event" android:text="🎨 自选主题"/>
                <Button android:id="@+id/event_1" style="@style/Button.Event" android:text="💬 情绪表达"/>
                <Button android:id="@+id/event_2" style="@style/Button.Event" android:text="🙋 主动求助"/>
            </TableRow>
            <TableRow android:layout_width="match_parent" android:layout_height="wrap_content">
                <Button android:id="@+id/event_3" style="@style/Button.Event" android:text="❔ 成人提问"/>
                <Button android:id="@+id/event_4" style="@style/Button.Event" android:text="↗ 成人引导"/>
                <Button android:id="@+id/event_5" style="@style/Button.Event" android:text="✏️ 画面修改"/>
            </TableRow>
            <TableRow android:layout_width="match_parent" android:layout_height="wrap_content">
                <Button android:id="@+id/event_6" style="@style/Button.Event" android:text="◌ 停顿思考"/>
                <Button android:id="@+id/event_7" style="@style/Button.Event" android:text="♡ 互动回应"/>
                <Button android:id="@+id/event_8" style="@style/Button.Event" android:text="＋ 其他事件"/>
            </TableRow>
        </TableLayout>
        <TextView android:id="@+id/last_event" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="24dp" android:gravity="center"
            android:text="等待第一个现场标记" android:textSize="12sp" android:textColor="@color/sage"/>
        <Button android:id="@+id/btn_stop" style="@style/Button.Primary"
            android:backgroundTint="@color/terracotta"
            android:layout_width="match_parent" android:layout_height="56dp" android:text="■  结束并进入整理"/>
    </LinearLayout>

    <ScrollView android:id="@+id/panel_review" android:layout_width="match_parent"
        android:layout_height="match_parent" android:visibility="gone" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="20dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="FIELD NOTES  /  REVIEW" android:textColor="@color/sage"
                android:textSize="11sp" android:letterSpacing="0.1"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="回看这段创作时光" style="@style/Heading.Large" android:layout_marginTop="14dp"/>
            <TextView android:id="@+id/review_info" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textSize="12sp" android:textColor="@color/subtext"
                android:layout_marginTop="8dp" android:layout_marginBottom="14dp"/>
            <VideoView android:id="@+id/review_video" android:layout_width="match_parent"
                android:layout_height="234dp" android:background="@color/ink"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:background="@drawable/card_surface"
                android:padding="14dp" android:layout_marginTop="14dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="现场事件 · 点击跳转" android:textColor="@color/ink"
                    android:textStyle="bold" android:textSize="16sp"/>
                <LinearLayout android:id="@+id/review_event_list"
                    android:orientation="vertical" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="8dp"/>
                <Button android:id="@+id/btn_add_review_event" style="@style/Button.Secondary"
                    android:layout_width="match_parent" android:layout_height="54dp"
                    android:text="＋ 在视频当前位置补记事件"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:background="@drawable/card_surface"
                android:padding="14dp" android:layout_marginTop="14dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="语音转写与情绪标签 · Qwen3" android:textColor="@color/ink"
                    android:textStyle="bold" android:textSize="16sp"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:text="录制后使用 Realtime WebSocket 逐块发送音频；不占用现场录音麦克风，按原视频时间轴写入结果。"
                    android:textColor="@color/subtext" android:textSize="12sp"/>
                <CheckBox android:id="@+id/consent_cloud_asr" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:minHeight="50dp" android:textSize="12sp"
                    android:text="已确认所有必要授权，同意将本次音频发送到 DashScope"/>
                <Button android:id="@+id/btn_qwen_analyze" style="@style/Button.Primary"
                    android:layout_width="match_parent" android:layout_height="54dp"
                    android:text="识别本次音频 · 一次 Qwen3 调用"/>
                <TextView android:id="@+id/speech_status" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="5dp"
                    android:text="未识别；无网络也可照常录制和导出" android:textColor="@color/subtext" android:textSize="12sp"/>
                <LinearLayout android:id="@+id/speech_list" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical"/>
                <Button android:id="@+id/btn_import_speaker" style="@style/Button.Secondary"
                    android:layout_width="match_parent" android:layout_height="50dp"
                    android:text="导入本地声纹分离 JSON · 关联 S1/S2"/>
            </LinearLayout>
            <Button android:id="@+id/btn_final_art" style="@style/Button.Secondary"
                android:layout_width="match_parent" android:layout_height="54dp"
                android:layout_marginTop="16dp" android:text="＋ 选择最终作品照片"/>
            <Button android:id="@+id/btn_export" style="@style/Button.Primary"
                android:layout_width="match_parent" android:layout_height="60dp"
                android:layout_marginTop="12dp" android:text="打包 GPT-6 资料 · 自动分包"/>
            <Button android:id="@+id/btn_archive" style="@style/Button.Secondary"
                android:layout_width="match_parent" android:layout_height="54dp"
                android:layout_marginTop="8dp" android:text="单独另存原始录像"/>
            <ProgressBar android:id="@+id/export_spinner" android:layout_width="48dp"
                android:layout_height="48dp" android:layout_gravity="center_horizontal"
                android:visibility="gone" android:layout_marginTop="12dp"/>
            <TextView android:id="@+id/export_status" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="每 ZIP 严格小于 400 MB；原录像不进入分析包。"
                android:textColor="@color/subtext" android:textSize="12sp"
                android:lineSpacingExtra="3dp" android:layout_marginTop="12dp"/>
            <Button android:id="@+id/btn_delete_session" style="@style/Button.Secondary"
                android:layout_width="match_parent" android:layout_height="54dp"
                android:layout_marginTop="12dp" android:textColor="@color/terracotta"
                android:text="删除本机此次记录（不可恢复）"/>
            <Button android:id="@+id/btn_new" style="@style/Button.Secondary"
                android:layout_width="match_parent" android:layout_height="54dp"
                android:layout_marginTop="20dp" android:layout_marginBottom="24dp"
                android:text="返回 · 新建记录"/>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
