<resources>
    <style name="Theme.HuaJian" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorAccent">@color/sage</item>
        <item name="android:statusBarColor">@color/paper</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/paper</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">@color/paper</item>
    </style>
    <style name="Button.Primary" parent="android:style/Widget.Material.Button">
        <item name="android:backgroundTint">@color/sage</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">54dp</item>
    </style>
    <style name="Button.Secondary" parent="android:style/Widget.Material.Button">
        <item name="android:backgroundTint">@color/sage_light</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">52dp</item>
    </style>
    <style name="Button.Event" parent="android:style/Widget.Material.Button">
        <item name="android:backgroundTint">@color/cream</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">12sp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:padding">2dp</item>
    </style>
    <style name="Heading"/>
    <style name="Heading.Large">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">29sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
</resources>
